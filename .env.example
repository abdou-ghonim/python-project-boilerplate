# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Python Project Boilerplate"
APP_SLUG=boilerplate
APP_VERSION=0.1.0
# development | dev | local | test enable development behaviour. Anything else
# (including unset) is treated as production.
FLASK_ENV=development
FLASK_APP=run.py
BASE_URL=http://localhost:5000/
TIMEZONE=Australia/Sydney

# ─── Secrets ────────────────────────────────────────────────────────────────
# Required. At least 32 bytes, or the app refuses to start:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# ─── Database ───────────────────────────────────────────────────────────────
# sqlite | postgresql | mysql | mssql
DB_PROVIDER=sqlite
DB_PATH=app.db                     # sqlite only
#DB_HOST=localhost
#DB_PORT=
#DB_NAME=app
#DB_USER=
#DB_PASSWORD=
#DB_OPTIONS=
#DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_REQUIRE_TLS=true                # fatal outside development when not met
DB_VERIFY_CERT=true
#DB_POOL_SIZE=5
#DB_ECHO=false
# Complete URI, used verbatim when set (managed-database connection strings):
#SQLALCHEMY_DATABASE_URI=

# Reflection scope for `flask generate-models` (blank = the provider's default)
# Database first: sql/<provider>/*.sql is the schema, applied by `flask db-apply`.
#SQL_SCHEMA_DIR=sql

#DATABASE_SCHEMAS=dbo,reference
#DATABASE_INCLUDE_TABLES=
#DATABASE_EXCLUDE_TABLES=
IGNORE_AUDIT_TRAIL_TABLES=true

# ─── Authentication ─────────────────────────────────────────────────────────
# local | oidc | none   ('none' refuses to start outside development)
AUTH_PROVIDER=local

# The account table. Database first: point these at the table you already have.
# AUTH_USER_COLUMNS renames individual fields; an entry with nothing after the
# `=` means the table has no such column and the model uses a constant instead.
#AUTH_USER_TABLE=app_user
#AUTH_USER_SCHEMA=
#AUTH_USER_COLUMNS=username=Email,display_name=FullName,role=

# Roles understood by @require_role, least privileged first.
#AUTH_ROLES=user,manager,admin
#AUTH_DEFAULT_ROLE=user

# Seeded by `flask db-apply` / `flask create-admin`. Seeding is refused outside
# development while the password is still the placeholder.
DEFAULT_ADMIN_USERNAME=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=12

# AUTH_PROVIDER=oidc
#OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid email profile
#OIDC_ROLE_CLAIM=roles
#OIDC_DEFAULT_ROLE=user

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_EXPIRY_MINUTES=60
#JWT_ISSUER=boilerplate
#JWT_AUDIENCE=boilerplate-api

# ─── Redis and the features built on it ─────────────────────────────────────
# Each switch makes its feature a no-op, so you can turn one off before you
# delete the code that implements it. See "Dropping what you do not need".
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
# Unreachable Redis is fatal when true (the default outside development).
REDIS_REQUIRED=false
#REDIS_KEY_PREFIX=boilerplate
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
JOBS_ENABLED=true
JOB_QUEUES=high,default,low

# ─── HTTP ───────────────────────────────────────────────────────────────────
# Dev only: the Vite server's origin. In production Flask serves the SPA, so
# leave both blank and no CORS headers are sent at all.
FRONTEND_URL=http://localhost:5173
#CORS_ORIGINS=

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text | json
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
#LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
